@model B2B.Core.Entities.Order
@{
    ViewData["Title"] = $"Wholesale Invoice #{Model.OrderID}";
    decimal grandTotal = Model.OrderDetails.Sum(d => d.Quantity * d.UnitAmount);
}

<div class="d-flex justify-content-between align-items-center mb-4 no-print flex-wrap gap-2">
    <div>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i>Back to My Orders
        </a>
    </div>
    <div class="d-flex gap-2">
        <button onclick="window.print()" class="btn btn-primary shadow-sm">
            <i class="bi bi-printer me-1"></i>Print Invoice / Save as PDF
        </button>
    </div>
</div>

<div class="card shadow-sm border p-4 p-md-5 bg-white">
    <!-- Header -->
    <div class="row pb-4 mb-4 border-bottom">
        <div class="col-sm-6">
            <h2 class="fw-bold text-primary mb-1">B2B Wholesale System</h2>
            <p class="text-muted small mb-0">Regional Commercial Distribution Hub</p>
            <p class="text-muted small mb-0">19 Nguyen Huu Tho, District 7, Ho Chi Minh City</p>
            <p class="text-muted small mb-0">Email: sales@b2bwholesale.vn | Phone: (028) 3775-5035</p>
        </div>
        <div class="col-sm-6 text-sm-end mt-3 mt-sm-0">
            <h3 class="fw-bold text-uppercase text-secondary mb-1">INVOICE</h3>
            <p class="mb-1"><strong>Invoice Number:</strong> #INV-@Model.OrderID.ToString("D6")</p>
            <p class="mb-1"><strong>Order Date:</strong> @Model.OrderDate.ToString("yyyy-MM-dd HH:mm")</p>
            <p class="mb-0">
                <strong>Status:</strong>
                <span class="badge bg-primary">@Model.OrderStatus</span>
            </p>
        </div>
    </div>

    <!-- Agent & Shipping Info -->
    <div class="row mb-4">
        <div class="col-sm-6">
            <h6 class="text-uppercase text-muted fw-bold mb-2 small">Billed & Shipped To:</h6>
            <h5 class="fw-bold mb-1">@Model.Agent?.AgentName</h5>
            <p class="text-muted mb-1"><i class="bi bi-geo-alt me-1"></i>@Model.Agent?.Address</p>
            <p class="text-muted mb-0"><i class="bi bi-telephone me-1"></i>@Model.Agent?.Phone</p>
        </div>
        <div class="col-sm-6 text-sm-end mt-3 mt-sm-0">
            <h6 class="text-uppercase text-muted fw-bold mb-2 small">Payment Terms:</h6>
            <p class="mb-1">Net 30 Days Wholesale Terms</p>
            <p class="text-muted small mb-0">Bank Transfer / Cash On Delivery</p>
        </div>
    </div>

    <!-- Items Table -->
    <div class="table-responsive mb-4">
        <table class="table table-bordered align-middle">
            <thead class="table-light">
                <tr>
                    <th style="width: 50px;">#</th>
                    <th>Item Description</th>
                    <th>Packaging Size</th>
                    <th class="text-end" style="width: 140px;">Unit Price</th>
                    <th class="text-center" style="width: 100px;">Quantity</th>
                    <th class="text-end" style="width: 160px;">Total (VND)</th>
                </tr>
            </thead>
            <tbody>
                @{ int counter = 1; }
                @foreach (var line in Model.OrderDetails)
                {
                    var lineTotal = line.Quantity * line.UnitAmount;
                    <tr>
                        <td class="text-center text-muted">@counter</td>
                        <td>
                            <strong>@line.Item?.ItemName</strong><br />
                            <small class="text-muted">Item ID: #@line.ItemID</small>
                        </td>
                        <td>@(line.Item?.Size ?? "Standard")</td>
                        <td class="text-end">@line.UnitAmount.ToString("N0") VND</td>
                        <td class="text-center fw-semibold">@line.Quantity</td>
                        <td class="text-end fw-bold">@lineTotal.ToString("N0") VND</td>
                    </tr>
                    counter++;
                }
            </tbody>
            <tfoot>
                <tr class="table-light">
                    <td colspan="5" class="text-end fw-bold fs-5">Grand Total:</td>
                    <td class="text-end fw-bold fs-5 text-primary">@grandTotal.ToString("N0") VND</td>
                </tr>
            </tfoot>
        </table>
    </div>

    <!-- Notes & Authorization -->
    <div class="row pt-3 border-top text-muted small">
        <div class="col-8">
            <p class="mb-1"><strong>Important Notes:</strong></p>
            <p class="mb-0">Please verify delivery contents upon carrier handover. Any discrepancies must be reported within 48 hours of dispatch.</p>
        </div>
        <div class="col-4 text-center">
            <p class="mb-5">Authorized Signature</p>
            <p class="mb-0 fw-bold">B2B Wholesale Operations</p>
        </div>
    </div>
</div>
