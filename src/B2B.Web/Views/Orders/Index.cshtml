@model IEnumerable<B2B.Core.Entities.Order>
@{
    ViewData["Title"] = "My Orders History";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-clock-history me-2 text-primary"></i>My Order History</h2>
        <p class="text-muted mb-0">Track all wholesale orders submitted under your registered agency.</p>
    </div>
    <div>
        <a asp-controller="Catalog" asp-action="Index" class="btn btn-primary shadow-sm">
            <i class="bi bi-plus-lg me-1"></i>New Order
        </a>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Order #</th>
                    <th>Date Placed</th>
                    <th>Status</th>
                    <th>Line Items</th>
                    <th>Total Value</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center py-4 text-muted">
                            <i class="bi bi-inbox me-2"></i>No past orders found for your agency.
                        </td>
                    </tr>
                }
                @foreach (var order in Model)
                {
                    var totalValue = order.OrderDetails.Sum(d => d.Quantity * d.UnitAmount);
                    <tr>
                        <td class="fw-bold text-primary">#@order.OrderID</td>
                        <td>@order.OrderDate.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>
                            @switch (order.OrderStatus)
                            {
                                case "Delivered":
                                    <span class="badge bg-success">Delivered</span>
                                    break;
                                case "Shipped":
                                    <span class="badge bg-info text-dark">Shipped</span>
                                    break;
                                case "Processing":
                                    <span class="badge bg-primary">Processing</span>
                                    break;
                                case "Cancelled":
                                    <span class="badge bg-danger">Cancelled</span>
                                    break;
                                default:
                                    <span class="badge bg-warning text-dark">Pending</span>
                                    break;
                            }
                        </td>
                        <td>@order.OrderDetails.Count items</td>
                        <td class="fw-bold">@totalValue.ToString("N0") VND</td>
                        <td class="text-end">
                            <a asp-action="Invoice" asp-route-id="@order.OrderID" class="btn btn-sm btn-outline-secondary">
                                <i class="bi bi-receipt me-1"></i>Printable Invoice
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
